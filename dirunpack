#!/usr/bin/env python3
"""Unpack .dir file to actual directory structure with 0-sized files"""

import os
import sys
import argparse


def unpack_dir_file(dir_file: str, output_dir: str):
    """Unpack .dir file to directory structure with 0-sized files"""
    if not os.path.exists(dir_file):
        print(f"Error: {dir_file} not found", file=sys.stderr)
        sys.exit(1)
    
    # Create output directory if it doesn't exist
    os.makedirs(output_dir, exist_ok=True)
    
    # Parse .dir file and create structure
    with open(dir_file, 'r') as f:
        lines = f.readlines()
    
    stack = [(-1, output_dir)]  # (indent_level, current_path) - start with -1 for root
    
    for line in lines:
        line = line.rstrip()
        if not line:
            continue
        
        # Calculate indent level
        indent = len(line) - len(line.lstrip())
        item = line.strip()
        
        if not item:
            continue
        
        # Pop stack until we find matching indent level
        while stack and stack[-1][0] >= indent:
            stack.pop()
        
        if not stack:
            # If stack is empty, reset to root
            stack = [(-1, output_dir)]
        
        _, parent_path = stack[-1]
        full_path = os.path.join(parent_path, item)
        
        if item.endswith('/'):
            # Directory
            os.makedirs(full_path, exist_ok=True)
            stack.append((indent, full_path))
        else:
            # File - create with 0 size (empty file)
            os.makedirs(os.path.dirname(full_path), exist_ok=True)
            # Create empty file (0-sized)
            with open(full_path, 'w'):
                pass  # Create file with no content


def main():
    parser = argparse.ArgumentParser(
        description='Unpack .dir file to actual directory structure with 0-sized files',
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        'dir_file',
        help='Path to .dir file to unpack'
    )
    parser.add_argument(
        '-o', '--output',
        default='.',
        help='Output directory (default: current directory)'
    )
    
    args = parser.parse_args()
    
    unpack_dir_file(args.dir_file, args.output)
    print(f"Unpacked {args.dir_file} to {args.output}")


if __name__ == '__main__':
    main()

